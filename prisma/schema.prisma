generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Topic {
  numerical
  verbal
  logical
  data_interpretation
  visual
}

enum Difficulty {
  easy
  medium
  hard
}

enum BatchStatus {
  draft
  published
  archived
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]
}

model Question {
  id               String        @id @default(uuid())
  topic            Topic
  difficulty       Difficulty
  language         String        @default("vi")
  stem             String
  optionA          String
  optionB          String
  optionC          String
  optionD          String
  correctOption    String
  explanation      String
  estimatedTimeSec Int           @default(60)
  batchLinks       BatchQuestion[]
  answers          SessionAnswer[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model QuestionBatch {
  id          String          @id @default(uuid())
  name        String
  status      BatchStatus     @default(draft)
  language    String          @default("vi")
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  questions   BatchQuestion[]
}

model BatchQuestion {
  batchId    String
  questionId String
  orderIndex Int

  batch      QuestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  question   Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([batchId, questionId])
  @@unique([batchId, orderIndex])
}

model Session {
  id            String          @id @default(uuid())
  userId        String
  timerSeconds  Int             @default(3600)
  score         Int             @default(0)
  correctCount  Int             @default(0)
  wrongCount    Int             @default(0)
  startedAt     DateTime        @default(now())
  endedAt       DateTime?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       SessionAnswer[]
}

model SessionAnswer {
  id             String   @id @default(uuid())
  sessionId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  timeSpentSec   Int      @default(0)

  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

model GenerationRun {
  id                 String   @id @default(uuid())
  targetCount        Int
  generatedCount     Int      @default(0)
  passedCount        Int      @default(0)
  rejectedCount      Int      @default(0)
  fallbackUsed       Boolean  @default(false)
  notes              String?
  createdAt          DateTime @default(now())
}
